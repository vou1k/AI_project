# Удали старый .gitignore если есть
rm .gitignore

# Создай новый с правильными правами
cat > .gitignore << 'EOF'
# Visual Studio files
.vs/
.vs/config/
.vs/*/
*.vsix

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
.env
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
*.log.*

# Test cache
.pytest_cache/
tests/__pycache__/
backend/__pycache__/
backend/app/__pycache__/
backend/app/agents/__pycache__/
backend/app/core/__pycache__/
demo_app/__pycache__/

# Project specific
temp_*
EOF